# ---- server ----
MUSE2API_HOST=127.0.0.1
MUSE2API_PORT=18610
MUSE2API_LOG_LEVEL=INFO
# External base URL for media links; empty = derive from request
MUSE2API_PUBLIC_BASE=

# ---- auth ----
# Empty = auto-generate and store in data/api_key
MUSE2API_API_KEY=
# Empty = same as API key
MUSE2API_ADMIN_KEY=

# ---- storage ----
MUSE2API_DATA_DIR=data
# Days of /v1/* request history kept in data/requests.db (pruned hourly)
MUSE2API_REQUEST_LOG_RETENTION_DAYS=14

# ---- driver: mock | browser | http ----
MUSE2API_DRIVER=mock

# browser driver
MUSE2API_CHROMIUM_PATH=
# Browser-only proxy. Leave empty when muse.ai is reachable directly.
# MUSE2API_BROWSER_PROXY=socks5://127.0.0.1:10808
MUSE2API_CDP_PORT=19210
MUSE2API_HEADLESS=true
MUSE2API_PAGE_READY_TIMEOUT=45

# ---- timeouts (seconds) ----
MUSE2API_CHAT_TIMEOUT=300
MUSE2API_FIRST_TOKEN_TIMEOUT=45
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600

# ---- account pool ----
# lru | round_robin | affinity
# affinity keeps one user on the same account so the hot page can be reused
MUSE2API_POOL_STRATEGY=affinity
MUSE2API_POOL_ACQUIRE_TIMEOUT=60
# Parallel requests per account; the browser driver opens one tab per slot.
# One account measured 8 images or 3 videos in parallel without errors.
MUSE2API_ACCOUNT_MAX_CONCURRENCY=4
# Seconds an account rests after an upstream error (timeouts excluded).
# Every parallel request on that account waits it out, so keep it short.
MUSE2API_ACCOUNT_COOLDOWN=30
MUSE2API_MAX_FAILOVER=2

# ---- background removal (images with background="transparent") ----
# Needs: pip install -e '.[matting]'. birefnet-general = best, birefnet-general-lite = faster
MUSE2API_MATTING_MODEL=birefnet-general

# ---- billing (prepaid USD credit on stored client keys) ----
# Admin/legacy keys and keys marked unlimited are never charged.
MUSE2API_BILLING_ENABLED=true
MUSE2API_PRICE_IMAGE_USD=0.015
MUSE2API_PRICE_VIDEO_PER_SECOND_USD=0.006
MUSE2API_VIDEO_DEFAULT_SECONDS=10
MUSE2API_PRICE_CHAT_INPUT_PER_MTOK_USD=1.0
MUSE2API_PRICE_CHAT_OUTPUT_PER_MTOK_USD=3.0

# ---- self-serve checkout at /billing (PayPal) ----
# From developer.paypal.com > Apps & Credentials (REST app). Leave empty to disable
# checkout: /billing then shows the support email and the order endpoints answer 503.
MUSE2API_PAYPAL_CLIENT_ID=
MUSE2API_PAYPAL_CLIENT_SECRET=
# sandbox | live (credentials must match the environment)
MUSE2API_PAYPAL_ENV=sandbox
# Sandbox payments are fake but give real credit: checkout stays off in sandbox
# unless this is true (testing only; /billing then shows a SANDBOX banner).
MUSE2API_PAYPAL_ALLOW_SANDBOX=false
# Webhook ID of https://<host>/billing/paypal/webhook; empty = webhooks are ignored
MUSE2API_PAYPAL_WEBHOOK_ID=
MUSE2API_TOPUP_MIN_USD=5
MUSE2API_TOPUP_MAX_USD=1000

# ---- session keepalive ----
MUSE2API_KEEPALIVE_ENABLED=false
MUSE2API_KEEPALIVE_INTERVAL=21600
